{
	"info": {
		"name": "API Afiliados",
		"description": "Pruebas de todos los endpoints de la API afiliados (v1).\n\nRequisitos: la API corriendo con el perfil dev (para /dev/token):\n  SPRING_PROFILES_ACTIVE=dev en .env y `docker compose up -d --build`.\nEjecute la colección completa en orden (Run collection): cada carpeta usa datos de la anterior.\n\nLos tokens se generan en cada ejecución y se guardan solo en variables de la colección: no se exportan ni se versionan.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{tokenAdmin}}",
				"type": "string"
			}
		]
	},
	"event": [
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Reglas comunes a todas las respuestas.",
					"pm.test(\"[común] Responde en menos de 2 s\", () => pm.expect(pm.response.responseTime).to.be.below(2000));",
					"if (pm.response.code >= 400) {",
					"\tpm.test(\"[común] Los errores son ProblemDetail (RFC 9457)\", () => {",
					"\t\tpm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/problem+json\");",
					"\t\tconst cuerpo = pm.response.json();",
					"\t\tpm.expect(cuerpo.status).to.eql(pm.response.code);",
					"\t\tpm.expect(cuerpo.title).to.be.a(\"string\");",
					"\t});",
					"\tpm.test(\"[común] Sin trazas ni detalles internos\", () => {",
					"\t\tconst texto = pm.response.text();",
					"\t\tpm.expect(texto).to.not.match(/Exception|at com\\.|at org\\.|SQL|Hibernate/);",
					"\t});",
					"}"
				]
			}
		}
	],
	"variable": [
		{
			"key": "tokenAdmin",
			"value": "",
			"description": "Lo llena \"Token ADMIN\" (o péguelo a mano si no usa el perfil dev)."
		},
		{
			"key": "tokenConsulta",
			"value": "",
			"description": "Lo llena \"Token CONSULTA\"."
		},
		{
			"key": "afiliadoId",
			"value": "",
			"description": "Lo llena \"Registrar afiliado\"."
		},
		{
			"key": "numeroDocumento",
			"value": "",
			"description": "Se genera al azar en cada ejecución (RN1)."
		},
		{
			"key": "tokenBasura",
			"value": ""
		},
		{
			"key": "tokenAlterado",
			"value": ""
		},
		{
			"key": "tokenSinFirma",
			"value": ""
		}
	],
	"item": [
		{
			"name": "00 Públicos (sin token)",
			"description": "Rutas que deben responder sin autenticación.",
			"item": [
				{
					"name": "Health",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"Estado UP\", () => pm.expect(pm.response.json().status).to.eql(\"UP\"));",
									"pm.test(\"No expone detalles internos (show-details: never)\", () => pm.expect(pm.response.json()).to.not.have.property(\"components\"));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/actuator/health",
						"auth": {
							"type": "noauth"
						}
					}
				},
				{
					"name": "OpenAPI (contrato)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
									"const esquema = pm.response.json().components.securitySchemes[\"bearer-jwt\"];",
									"pm.test(\"Declara el esquema Bearer JWT (botón Authorize)\", () => {",
									"\tpm.expect(esquema.scheme).to.eql(\"bearer\");",
									"\tpm.expect(esquema.bearerFormat).to.eql(\"JWT\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/v3/api-docs",
						"auth": {
							"type": "noauth"
						}
					}
				},
				{
					"name": "Swagger UI",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 200 con HTML\", () => {",
									"\tpm.response.to.have.status(200);",
									"\tpm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"text/html\");",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/swagger-ui/index.html",
						"auth": {
							"type": "noauth"
						}
					}
				}
			]
		},
		{
			"name": "01 Tokens de prueba (perfil dev)",
			"description": "Requiere arrancar la API con SPRING_PROFILES_ACTIVE=dev. Guarda los tokens en variables de la colección (no en archivos).\nSin el perfil dev, pegue tokens emitidos por su proveedor en las variables tokenAdmin y tokenConsulta y omita esta carpeta.",
			"item": [
				{
					"name": "Token ADMIN",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 200 (si da 401, la API no corre con el perfil dev)\", () => pm.response.to.have.status(200));",
									"const cuerpo = pm.response.json();",
									"pm.test(\"Es un token Bearer de 1 hora\", () => {",
									"\tpm.expect(cuerpo.tipo).to.eql(\"Bearer\");",
									"\tpm.expect(cuerpo.expiraEnSegundos).to.eql(3600);",
									"});",
									"pm.collectionVariables.set(\"tokenAdmin\", cuerpo.token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{baseUrl}}/dev/token?roles=ADMIN&sujeto=admin.postman",
						"auth": {
							"type": "noauth"
						}
					}
				},
				{
					"name": "Token CONSULTA",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
									"const token = pm.response.json().token;",
									"const payload = JSON.parse(atob(token.split(\".\")[1].replace(/-/g, \"+\").replace(/_/g, \"/\")));",
									"pm.test(\"El claim roles es [CONSULTA]\", () => pm.expect(payload.roles).to.eql([\"CONSULTA\"]));",
									"pm.test(\"Trae emisor y vencimiento\", () => {",
									"\tpm.expect(payload.iss).to.be.a(\"string\");",
									"\tpm.expect(payload.exp).to.be.above(Math.floor(Date.now() / 1000));",
									"});",
									"pm.collectionVariables.set(\"tokenConsulta\", token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{baseUrl}}/dev/token?roles=CONSULTA&sujeto=lector.postman",
						"auth": {
							"type": "noauth"
						}
					}
				},
				{
					"name": "Rol inexistente → 400",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 400: solo emite roles conocidos\", () => pm.response.to.have.status(400));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"url": "{{baseUrl}}/dev/token?roles=SUPERUSUARIO",
						"auth": {
							"type": "noauth"
						}
					}
				}
			]
		},
		{
			"name": "02 Autenticación (401)",
			"description": "Peticiones sin token o con tokens inválidos: nunca deben llegar al negocio.",
			"item": [
				{
					"name": "Sin token → 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
									"pm.test(\"Tipo de problema no-autenticado\", () => pm.expect(pm.response.json().type).to.eql(\"urn:afiliados:problema:no-autenticado\"));",
									"pm.test(\"Cabecera WWW-Authenticate: Bearer (RFC 6750)\", () => pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.match(/^Bearer/));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/v1/afiliados",
						"auth": {
							"type": "noauth"
						}
					}
				},
				{
					"name": "POST sin token → 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
									"pm.test(\"Tipo de problema no-autenticado\", () => pm.expect(pm.response.json().type).to.eql(\"urn:afiliados:problema:no-autenticado\"));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/api/v1/afiliados",
						"auth": {
							"type": "noauth"
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tipoDocumento\": \"CC\",\n  \"numeroDocumento\": \"{{numeroDocumento}}\",\n  \"nombres\": \"Ana María\",\n  \"apellidos\": \"Pérez Ruiz\",\n  \"email\": \"ana.perez@correo.com\",\n  \"salario\": 3000000\n}"
						}
					}
				},
				{
					"name": "Token con formato inválido → 401",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.collectionVariables.set(\"tokenBasura\", \"abc.def.ghi\");"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
									"pm.test(\"Tipo de problema no-autenticado\", () => pm.expect(pm.response.json().type).to.eql(\"urn:afiliados:problema:no-autenticado\"));",
									"pm.test(\"WWW-Authenticate indica invalid_token\", () => pm.expect(pm.response.headers.get(\"WWW-Authenticate\")).to.include(\"invalid_token\"));",
									"pm.test(\"El cuerpo no explica por qué falló\", () => pm.expect(pm.response.json().detail).to.eql(\"Se requiere un token Bearer válido\"));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/v1/afiliados",
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{tokenBasura}}",
									"type": "string"
								}
							]
						}
					}
				},
				{
					"name": "Token CONSULTA alterado a ADMIN → 401",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const aB64 = (s) => btoa(s).replace(/\\+/g, \"-\").replace(/\\//g, \"_\").replace(/=+$/, \"\");",
									"const deB64 = (s) => atob(s.replace(/-/g, \"+\").replace(/_/g, \"/\"));",
									"const [cabecera, payload, firma] = pm.collectionVariables.get(\"tokenConsulta\").split(\".\");",
									"const datos = JSON.parse(deB64(payload));",
									"datos.roles = [\"ADMIN\"];",
									"pm.collectionVariables.set(\"tokenAlterado\", [cabecera, aB64(JSON.stringify(datos)), firma].join(\".\"));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
									"pm.test(\"Tipo de problema no-autenticado\", () => pm.expect(pm.response.json().type).to.eql(\"urn:afiliados:problema:no-autenticado\"));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/v1/afiliados",
						"description": "Toma el token CONSULTA, cambia el claim roles a ADMIN sin volver a firmar. La firma deja de coincidir.",
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{tokenAlterado}}",
									"type": "string"
								}
							]
						}
					}
				},
				{
					"name": "Token sin firma (alg none) → 401",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const aB64 = (s) => btoa(s).replace(/\\+/g, \"-\").replace(/\\//g, \"_\").replace(/=+$/, \"\");",
									"const exp = Math.floor(Date.now() / 1000) + 300;",
									"const payload = { iss: \"afiliados-api\", sub: \"atacante\", roles: [\"ADMIN\"], exp };",
									"pm.collectionVariables.set(\"tokenSinFirma\", aB64('{\"alg\":\"none\"}') + \".\" + aB64(JSON.stringify(payload)) + \".\");"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
									"pm.test(\"Tipo de problema no-autenticado\", () => pm.expect(pm.response.json().type).to.eql(\"urn:afiliados:problema:no-autenticado\"));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/v1/afiliados",
						"description": "Ataque clásico: declarar \"alg\":\"none\" para que el servidor no verifique la firma.",
						"auth": {
							"type": "bearer",
							"bearer": [
								{
									"key": "token",
									"value": "{{tokenSinFirma}}",
									"type": "string"
								}
							]
						}
					}
				},
				{
					"name": "Token en la URL (?access_token=) → 401",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 401\", () => pm.response.to.have.status(401));",
									"pm.test(\"Tipo de problema no-autenticado\", () => pm.expect(pm.response.json().type).to.eql(\"urn:afiliados:problema:no-autenticado\"));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/v1/afiliados?access_token={{tokenAdmin}}",
						"description": "Los tokens en la URL quedan en logs, historial y proxies: la API solo los acepta en la cabecera.",
						"auth": {
							"type": "noauth"
						}
					}
				}
			]
		},
		{
			"name": "03 Flujo completo ADMIN",
			"description": "Registrar → consultar → listar → actualizar → inactivar (RN2 y RN4). Usa el token ADMIN heredado de la colección.",
			"item": [
				{
					"name": "Registrar afiliado → 201",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Documento aleatorio de 10 dígitos: la colección se puede ejecutar muchas veces sin chocar con RN1.",
									"pm.collectionVariables.set(\"numeroDocumento\", String(Math.floor(1e9 + Math.random() * 9e9)));"
								]
							}
						},
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const smmlv = Number(pm.collectionVariables.get(\"smmlv\") || pm.environment.get(\"smmlv\"));",
									"const categoria = (salario) => salario <= 2 * smmlv ? \"A\" : salario <= 4 * smmlv ? \"B\" : \"C\";",
									"pm.test(\"Responde 201 Created\", () => pm.response.to.have.status(201));",
									"const afiliado = pm.response.json();",
									"pm.test(\"Location apunta al recurso creado (ruta relativa)\", () =>",
									"\tpm.expect(pm.response.headers.get(\"Location\")).to.eql(\"/api/v1/afiliados/\" + afiliado.id));",
									"pm.test(\"RN4: un afiliado nuevo queda ACTIVO\", () => pm.expect(afiliado.estado).to.eql(\"ACTIVO\"));",
									"pm.test(\"RN2: categoría calculada con el SMMLV\", () => pm.expect(afiliado.categoria).to.eql(categoria(3000000)));",
									"pm.test(\"Devuelve los datos registrados\", () => {",
									"\tpm.expect(afiliado.numeroDocumento).to.eql(pm.collectionVariables.get(\"numeroDocumento\"));",
									"\tpm.expect(afiliado.nombres).to.eql(\"Ana María\");",
									"});",
									"pm.collectionVariables.set(\"afiliadoId\", afiliado.id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/api/v1/afiliados",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"tipoDocumento\": \"CC\",\n  \"numeroDocumento\": \"{{numeroDocumento}}\",\n  \"nombres\": \"Ana María\",\n  \"apellidos\": \"Pérez Ruiz\",\n  \"email\": \"ana.perez@correo.com\",\n  \"salario\": 3000000\n}"
						}
					}
				},
				{
					"name": "Consultar por id → 200",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"Es el afiliado registrado\", () => pm.expect(String(pm.response.json().id)).to.eql(String(pm.collectionVariables.get(\"afiliadoId\"))));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/v1/afiliados/{{afiliadoId}}"
					}
				},
				{
					"name": "Listar → 200",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"pm.test(\"Responde 200 con una lista\", () => {",
									"\tpm.response.to.have.status(200);",
									"\tpm.expect(pm.response.json()).to.be.an(\"array\");",
									"});",
									"pm.test(\"Incluye el afiliado registrado\", () => {",
									"\tconst ids = pm.response.json().map((a) => String(a.id));",
									"\tpm.expect(ids).to.include(String(pm.collectionVariables.get(\"afiliadoId\")));",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/v1/afiliados"
					}
				},
				{
					"name": "Actualizar salario (categoría B) → 200",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const smmlv = Number(pm.collectionVariables.get(\"smmlv\") || pm.environment.get(\"smmlv\"));",
									"const categoria = (salario) => salario <= 2 * smmlv ? \"A\" : salario <= 4 * smmlv ? \"B\" : \"C\";",
									"pm.test(\"Responde 200\", () => pm.response.to.have.status(200));",
									"pm.test(\"RN2: recalcula la categoría al cambiar el salario\", () => pm.expect(pm.response.json().categoria).to.eql(categoria(5000000)));",
									"pm.test(\"Actualiza el email\", () => pm.expect(pm.response.json().email).to.eql(\"ana.maria@correo.com\"));",
									"pm.test(\"El documento no cambia (es la identidad)\", () => pm.expect(pm.response.json().numeroDocumento).to.eql(pm.collectionVariables.get(\"numeroDocumento\")));"
								]
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"url": "{{baseUrl}}/api/v1/afiliados/{{afiliadoId}}",
						"body": {
							"mode": "raw",
							"raw": "{\n  \"nombres\": \"Ana María\",\n  \"apellidos\": \"Pérez Ruiz\",\n  \"email\": \"ana.maria@correo.com\",\n  \"salario\": 5000000\n}"
						}
					}
				},
				{
					"name": "Actualizar salario (categoría C) → 200",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const smmlv = Number(pm.collectionVariables.get(\"smmlv\") || pm.environment.get(\"smmlv\"));",
