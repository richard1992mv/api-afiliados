		{
			"name": "06 Cabeceras de seguridad",
			"description": "Cabeceras que Spring Security agrega a cada respuesta.",
			"item": [
				{
					"name": "Cabeceras en una respuesta autenticada",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const h = (nombre) => pm.response.headers.get(nombre);",
									"pm.test(\"X-Content-Type-Options: nosniff\", () => pm.expect(h(\"X-Content-Type-Options\")).to.eql(\"nosniff\"));",
									"pm.test(\"X-Frame-Options: DENY\", () => pm.expect(h(\"X-Frame-Options\")).to.eql(\"DENY\"));",
									"pm.test(\"Referrer-Policy: no-referrer\", () => pm.expect(h(\"Referrer-Policy\")).to.eql(\"no-referrer\"));",
									"pm.test(\"Cache-Control impide guardar datos personales\", () => pm.expect(h(\"Cache-Control\")).to.include(\"no-store\"));",
									"pm.test(\"Stateless: no crea cookie de sesión\", () => pm.expect(pm.response.headers.has(\"Set-Cookie\")).to.be.false);",
									"// HSTS solo se envía por HTTPS; en http://localhost su ausencia es lo correcto.",
									"const https = pm.request.url.protocol === \"https\";",
									"pm.test(\"HSTS solo por HTTPS\", () => pm.expect(pm.response.headers.has(\"Strict-Transport-Security\")).to.eql(https));"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/api/v1/afiliados"
					}
				}
			]
		}
