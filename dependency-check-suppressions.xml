<?xml version="1.0" encoding="UTF-8"?>
<!--
  Falsos positivos aceptados de OWASP Dependency-Check.

  Cada supresión debe ser lo más específica posible y explicar por qué no aplica:
    - packageUrl o sha1 de la dependencia exacta (no un patrón amplio)
    - cve concreto (no toda la librería)
    - until="AAAA-MM-DDZ" para que venza y se vuelva a revisar

  Ejemplo:
  <suppress until="2027-02-01Z">
    <notes>CVE-XXXX-YYYY afecta al módulo X, que este proyecto no usa. Revisado por: ...</notes>
    <packageUrl regex="true">^pkg:maven/org\.ejemplo/libreria@.*$</packageUrl>
    <cve>CVE-XXXX-YYYY</cve>
  </suppress>
-->
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">
</suppressions>
