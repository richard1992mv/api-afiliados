# Plantilla de variables de entorno. NO contiene valores reales.
# Copia este archivo a .env (que está en .gitignore) y completa los valores.

# --- Contenedor MySQL (docker-compose.yml) ---
MYSQL_ROOT_PASSWORD=cambiar_por_password_root
MYSQL_DATABASE=afiliados
# Puerto del host donde se publica MySQL; solo con docker-compose.db-local.yml
# (correr la app desde el IDE). Debe coincidir con el de DB_URL.
MYSQL_HOST_PORT=3307

# --- Aplicación Spring Boot (application.yml) ---
# DB_URL se usa al correr la app desde el IDE; en docker compose la app usa mysql:3306.
DB_URL=jdbc:mysql://localhost:3307/afiliados
DB_USER=cambiar_por_usuario
DB_PASSWORD=cambiar_por_password

# --- Reglas de negocio (opcional) ---
# SMMLV vigente; si no se define, se usa el valor por defecto de application.yml.
# AFILIADOS_SMMLV=1750905

# --- Docker Compose (opcional) ---
# Puerto del host para la API (por defecto 8080).
# APP_HOST_PORT=8080
# Swagger UI; en producción conviene false.
# SWAGGER_ENABLED=true
